{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guteng-storefront-test",
  "main": "worker.js",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules/**",
      ".git/**",
      "*.log",
      "wrangler.jsonc",
      "package.json",
      "bun.lockb",
      "package-lock.json",
      "tsconfig.json",
      "README.md"
    ],
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guteng-db-test",
      "database_id": "cd90aed3-c679-442c-a04b-d2ce5ff35067",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PAYPAL_MODE": "sandbox"
  }
}
